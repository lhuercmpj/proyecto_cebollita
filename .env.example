POSTGRES_DB=cebollita
POSTGRES_USER=cebollita
POSTGRES_PASSWORD=cebollita_dev
SENSOR_DEVICE_URL=http://simulator:8081
SENSOR_TIMEOUT_SECONDS=20

# Medicion y reportes automaticos
REPORT_INTERVAL_MINUTES=30
STALE_MARGIN_MINUTES=10
ALERT_REPEAT_MINUTES=180

# Telegram: crear el bot con @BotFather y pegar el token
TELEGRAM_BOT_TOKEN=
# Opcional: chat fijo que siempre recibe reportes (ademas de quienes hagan /start)
TELEGRAM_CHAT_ID=
# Opcional: lista de chat_id permitidos, separados por coma (vacio = cualquiera)
TELEGRAM_ALLOWED_CHAT_IDS=

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
